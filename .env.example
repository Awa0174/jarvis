# JARVIS — example environment file
# ===================================================================
# EVERYTHING HERE IS OPTIONAL in the default (bridge) mode. JARVIS runs
# perfectly with an empty file — the bridge authenticates off your Claude Code
# login, and voice input and output both fall back to the browser's own speech.
# Copy this to .env.local, and add only what you actually want to change.
#
# The one line worth adding is ELEVENLABS_API_KEY, down in the BRIDGE section:
# it gives you a much better voice and Scribe transcription. The free tier is
# plenty for a demo. Never commit a real key.
#
# Two audiences read these variables:
#   - the BRIDGE (the Node server, bridge/server.mjs) reads the JARVIS_* and
#     ELEVENLABS_API_KEY variables from its shell environment.
#   - the FRONTEND (the Vite app) reads the VITE_* variables from .env.local.
# Only VITE_-prefixed values ever reach the browser.


# ===================================================================
# BRIDGE (the server) — read from the shell that runs `npm run bridge`
# ===================================================================
# These are shown with their defaults. Leave them unset to accept the default.

# Port the bridge listens on (WebSocket + a few HTTP endpoints). Default 8787.
# If you change it, change VITE_BRIDGE_URL to match.
# JARVIS_BRIDGE_PORT=8787

# The model the bridge asks Claude Code to run. Default claude-opus-5.
# JARVIS_MODEL=claude-opus-5

# Reasoning effort. Default medium.
# JARVIS_EFFORT=medium

# What happens when JARVIS wants to run a shell command, write a file, click
# or type in the browser, send, install, delete — anything that changes
# something. Reading is always free. Three modes:
#   confirm  (default) each such call is held until you approve it in the
#            interface: click "Ausführen", press Enter, or say "Jarvis,
#            ausführen". JARVIS has to explain what, why and the risk first.
#   deny     refused outright; JARVIS can look at anything and change nothing.
#   allow    everything runs without asking. For demos only.
# `npm run bridge:writes` / `npm start -- --writes` select allow.
# Read the classifyTool gate in bridge/server.mjs before changing this.
# JARVIS_WRITE_MODE=confirm

# Seconds-in-milliseconds the card waits for your answer before counting as no.
# JARVIS_CONFIRM_TIMEOUT_MS=90000

# Where he keeps what he knows about you: one fact per line, plain text,
# outside the repository. Open it to read or delete anything.
# JARVIS_MEMORY_FILE=~/.jarvis/memory.md

# The servers he may look at: a JSON list outside the repository, see
# servers.example.json. SSH with keys only; status and logs are read freely,
# any command or restart goes through the confirmation card.
# JARVIS_SERVERS_FILE=~/.jarvis/servers.json
# Game servers behind a Pterodactyl panel need no SSH: a *client* API key
# from the panel (Account → API Credentials). Status and files are read
# freely; power signals and console commands go through the card.
# JARVIS_PTERO_URL=https://panel.example.com
# JARVIS_PTERO_KEY=ptlc_…

# --- Mail (read-only, IMAP) -------------------------------------------------
# For Gmail: switch IMAP on in Gmail settings, then make an app password
# (Google account → Security → 2-step verification → App passwords) and put
# THAT here, never the real password. Other providers: set host and port.
# JARVIS_MAIL_USER=you@gmail.com
# JARVIS_MAIL_PASS=xxxx xxxx xxxx xxxx
# JARVIS_MAIL_HOST=imap.gmail.com
# JARVIS_MAIL_PORT=993

# --- Everyday ---------------------------------------------------------------
# Private iCal addresses of your calendars, comma separated; read-only.
# Google: calendar settings → "Secret address in iCal format".
# Outlook.com: calendar settings → shared calendars → publish → ICS link.
# JARVIS_CALENDAR_ICS=https://calendar.google.com/calendar/ical/…/basic.ics
# Home town for the weather and the briefing.
# JARVIS_LOCATION=Berlin
# When the morning briefing comes, once a day, while the interface is open;
# a later start still gets it within JARVIS_BRIEFING_WINDOW_H hours.
# JARVIS_BRIEFING_AT=08:00
# JARVIS_BRIEFING_WINDOW_H=4

# --- Model router -------------------------------------------------------------
# Every question is placed in a tier before it reaches the agent: fixed rules
# first (time, date, "öffne …", greetings — no model at all), then a one-word
# vote by the router model. "Jarvis, denk gründlich nach …" forces fable.
# The bridge log shows the choice on every turn, the HUD footer too.
# JARVIS_ROUTER=1
# JARVIS_MODEL_HAIKU=claude-haiku-5-5
# JARVIS_MODEL_SONNET=claude-sonnet-5-5
# JARVIS_MODEL_OPUS=claude-opus-5-5
# JARVIS_MODEL_FABLE=claude-fable-5-1
# Let the router model vote on what the rules do not settle. Off by default:
# one SDK round trip costs 3–4 s even for a one-word answer, in front of
# every answer. With it off, keywords pick opus/fable and the rest is sonnet.
# JARVIS_ROUTER_VOTE=0
# The model that votes (default: the haiku tier).
# JARVIS_MODEL_ROUTER=claude-haiku-5-5
# Where a question lands when the vote fails or times out.
# JARVIS_DEFAULT_TIER=sonnet
# JARVIS_ROUTER_TIMEOUT_MS=4000

# Which engine speaks. browser (default) uses the page's own speechSynthesis —
# in Edge on Windows that is the natural "Online" voices; press V in the
# interface to cycle through them, the choice is remembered. piper is a neural
# voice running locally in the bridge (`npm run setup:piper` fetches it once).
# elevenlabs needs the key below.
# JARVIS_TTS=browser
# The Piper voice, from tools/piper/voices. high sounds best; medium is quicker.
# JARVIS_PIPER_VOICE=de_DE-thorsten-high
# Pace: 1.0 is the voice's own tempo, higher is slower.
# JARVIS_PIPER_LENGTH=1.05

# Local speech recognition (whisper.cpp). `npm run setup:whisper` fetches the
# CUDA build and the model into tools/whisper; when it runs, the page stops
# using the browser's recogniser and sends each spoken segment to the bridge.
# JARVIS_WHISPER_MODEL=ggml-large-v3-turbo-q5_0.bin
# JARVIS_WHISPER_LANG=de
# JARVIS_WHISPER_THREADS=8
# JARVIS_WHISPER_PORT=8178
# Encoder window in frames (1500 = 30 s). 768 ≈ 15 s halves the latency with
# no loss on spoken commands; 512 ≈ 10 s is quicker still. 0 = full.
# JARVIS_WHISPER_AUDIO_CTX=768
# A phrase that nudges spelling, e.g. his name.
# JARVIS_WHISPER_PROMPT=Hey Jarvis.

# --- Frontend: language -----------------------------------------------------
# The language he listens in and speaks (BCP-47). Drives the browser's speech
# recognition and the voice ranking; the persona answers in German regardless.
# On Windows, Edge's "Conrad Online (Natural)" is picked first for de-DE.
# VITE_JARVIS_LANG=de-DE
# The browser voice, by a fragment of its name (case-insensitive). It ranks
# above everything else that is installed. Default: andrew multilingual.
# VITE_JARVIS_VOICE=andrew multilingual

# Older switch, still honoured: 1 means allow. Prefer JARVIS_WRITE_MODE.
# JARVIS_ALLOW_WRITES=0

# Extra browser origins allowed to open the agent WebSocket, comma separated.
# Local dev origins are already allowed; add others only if you serve the app
# from a different address. Default: none.
# JARVIS_ALLOWED_ORIGINS=

# Allow clients that send no Origin header at all (curl, scripts, native apps).
# Off by default, because that is also what local malware looks like. Default 0.
# JARVIS_ALLOW_NO_ORIGIN=0

# Extra directories the bridge's /file endpoint may serve from, comma separated.
# Your home directory and the system temp directory are always included; this is
# for anything outside them, such as an external drive of footage. Default: none.
# JARVIS_FILE_ROOTS=

# ElevenLabs voice id for the bridge's own speech endpoint. Default: George.
# JARVIS_VOICE_ID=JBFqnCBsd6RMkjVDRZzb

# ElevenLabs API key. Optional. With it, JARVIS speaks in the ElevenLabs voice
# and transcribes with ElevenLabs Scribe; without it, everything still works on
# the browser's own speech. If you already have an elevenlabs MCP server in
# ~/.claude.json, the bridge reads the key from there and you can leave this
# blank. Default: none.
# ELEVENLABS_API_KEY=


# ===================================================================
# FRONTEND (Vite) — put these in .env.local
# ===================================================================

# Which brain the browser talks to. Default bridge.
#   bridge — talk to the local bridge (recommended). No API key, and every MCP
#            server in your Claude Code config is available.
#   direct — the browser calls the Claude API itself. Needs VITE_ANTHROPIC_API_KEY.
# VITE_BACKEND=bridge

# Where the bridge listens. Keep the port in step with JARVIS_BRIDGE_PORT above.
# Default ws://localhost:8787.
# VITE_BRIDGE_URL=ws://localhost:8787

# Browser text-to-speech engine, used when no ElevenLabs voice is active.
# Default system.
#   system — the browser's built-in speechSynthesis. Instant, on-device.
#   kokoro — a neural voice running in the browser. Better sound, slower to start.
# VITE_TTS_ENGINE=system

# Which Kokoro voice, when VITE_TTS_ENGINE=kokoro. Default bm_george.
# VITE_KOKORO_VOICE=bm_george

# Prefer the ElevenLabs voice from the browser when a key is available.
# Default false.
# VITE_USE_ELEVENLABS=false

# Anthropic API key — DIRECT MODE ONLY. Required if and only if
# VITE_BACKEND=direct, and it ships to the browser, so use it only for a local
# demo. The default bridge mode never reads it. Default: none.
# VITE_ANTHROPIC_API_KEY=
